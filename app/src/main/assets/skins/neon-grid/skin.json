      {"type":"text","bounds":[22,51,436,32],"text":"> {search.query}","size":16,"color":"accent","overflow":"clip"},
      {"type":"rows","bounds":[12,91,456,96],"rowHeight":45,"gap":5,"scrolling":"center","children":[{"type":"component","bounds":[0,0,456,45],"asset":"row"}]},
      {"type":"text","bounds":[26,96,428,82],"text":"{empty.message}","size":14,"color":"secondaryText","lines":3,"verticalAlign":"top","when":"emptyRows"},
      {"type":"keyboard","bounds":[12,196,456,156],"size":13,"bold":true,"keyStyle":{"gap":3,"radius":4,"color":"secondaryText","background":"surface","focusColor":"background","focusBackground":"accent","borderColor":"divider","borderWidth":1}},

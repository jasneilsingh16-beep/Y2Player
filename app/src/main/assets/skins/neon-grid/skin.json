    "footer": [
      {"type":"rect","bounds":[0,326,480,34],"color":"surface","opacity":0.96},
      {"type":"line","bounds":[12,326,456,1],"color":"divider","stroke":1},
      {"type":"text","bounds":[12,329,326,25],"text":"▶ {track.title}","style":"meta","overflow":"marquee","marqueeSpeed":28,"action":"nowPlaying"},
      {"type":"text","bounds":[350,329,118,25],"text":"{position}","style":"label","align":"right"}
    ],
    "row": [
      {"type":"rect","bounds":[0,0,456,48],"anchor":"stretch","color":"surface","borderColor":"divider","borderWidth":1,"radius":4,"states":{"focused":{"color":"focusSurface","borderColor":"accent","borderWidth":2},"active":{"borderColor":"success","borderWidth":2},"disabled":{"opacity":0.42}},"transitionMs":140},
      {"type":"rect","bounds":[0,8,4,32],"color":"accent","radius":2,"states":{"active":{"color":"success"},"focused":{"color":"accentHot"}},"transitionMs":120},
      {"type":"icon","bounds":[12,12,24,24],"color":"secondaryText","states":{"focused":{"color":"accent"},"disabled":{"opacity":0.35}},"transitionMs":120},
      {"type":"text","bounds":[46,2,350,25],"text":"{row.title}","size":16,"bold":true,"overflow":"marquee","states":{"focused":{"color":"primaryText"},"disabled":{"color":"mutedText"}}},
      {"type":"text","bounds":[46,27,350,17],"text":"{row.subtitle}","style":"micro"},
      {"type":"text","bounds":[400,5,44,18],"text":"{row.number}","style":"micro","align":"right"},
      {"type":"circle","bounds":[429,29,10,10],"color":"success","when":"active"},
      {"type":"path","bounds":[430,7,10,10],"points":[[0,0],[1,1],[0,1],[1,0]],"stroke":2,"color":"warning","when":"unavailable"}
    ],
    "menuTile": [
      {"type":"rect","bounds":[0,0,222,74],"anchor":"stretch","color":"surface","borderColor":"divider","borderWidth":1,"radius":6,"states":{"focused":{"color":"focusSurface","borderColor":"accent","borderWidth":2},"pressed":{"color":"accentHot"},"disabled":{"opacity":0.4}},"transitionMs":160},
      {"type":"circle","bounds":[12,13,28,28],"color":"surfaceRaised","borderColor":"accent","borderWidth":1},
      {"type":"icon","bounds":[18,19,16,16],"color":"accent"},
      {"type":"text","bounds":[50,7,158,26],"text":"{row.title}","size":16,"bold":true,"overflow":"marquee"},
      {"type":"text","bounds":[50,34,158,28],"text":"{row.subtitle}","style":"micro","lines":2,"verticalAlign":"top"},
      {"type":"line","bounds":[12,64,196,1],"color":"accentHot","stroke":1,"when":"focused"}
    ],
    "hudButton": {
      "parameters": {"label":"PLAY","command":"playPause","id":"play","group":"transport","order":0,"tone":"accent"},
      "nodes": [
        {"type":"rect","bounds":[0,0,100,40],"anchor":"stretch","color":"surfaceRaised","borderColor":"divider","borderWidth":1,"radius":5,"action":"{param.command}","focus":{"id":"{param.id}","group":"{param.group}","order":"{param.order}"},"states":{"focused":{"color":"focusSurface","borderColor":"{param.tone}","borderWidth":2},"pressed":{"color":"{param.tone}"},"disabled":{"opacity":0.35}},"transitionMs":130},
        {"type":"text","bounds":[4,2,92,36],"anchor":"stretch","text":"{param.label}","style":"label","color":"{param.tone}","align":"center"}
      ]
    },
    "overlays": [
      {"type":"group","bounds":[12,250,456,70],"when":"message","children":[
        {"type":"rect","bounds":[0,0,456,70],"color":"void","opacity":0.96,"borderColor":"warning","borderWidth":2,"radius":6},
        {"type":"rect","bounds":[0,0,7,70],"color":"warning"},
        {"type":"text","bounds":[18,6,426,58],"text":"// SYSTEM MESSAGE\n{message}","size":12,"color":"warning","lines":3,"verticalAlign":"top","lineSpacing":1.15}
      ]},
      {"type":"group","bounds":[188,126,104,104],"when":"alphabet","children":[
        {"type":"circle","bounds":[0,0,104,104],"color":"surface","borderColor":"accentHot","borderWidth":3},
        {"type":"circle","bounds":[8,8,88,88],"color":"void","borderColor":"accent","borderWidth":1},
        {"type":"text","bounds":[0,0,104,104],"text":"{alphabet}","size":43,"bold":true,"color":"accent","align":"center"}
      ]}
    ]
  },
  "navigation": {"now_playing":{"initial":"play","wrap":true}},

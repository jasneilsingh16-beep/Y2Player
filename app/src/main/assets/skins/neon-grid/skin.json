{
  "formatVersion": 2,
  "id": "neon-grid",
  "name": "Neon Grid",
  "author": "Y2Player",
  "viewport": [480, 360],
  "font": "monospace",
  "colors": {
    "background": "#02040A", "void": "#00030A", "surface": "#07121D",
    "surfaceRaised": "#0B2030", "focusSurface": "#113B47",
    "primaryText": "#ECFFFF", "secondaryText": "#86DCE5", "mutedText": "#527986",
    "accent": "#00F5D4", "accentHot": "#FF3CAC", "electric": "#5C7CFA",

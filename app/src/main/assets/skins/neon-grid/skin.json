      {"type":"text","bounds":[205,210,259,20],"text":"{playback.elapsed} / {playback.duration}","style":"meta","align":"right"},
      {"type":"group","bounds":[16,242,448,45],"layout":"row","gap":7,"children":[
        {"type":"component","bounds":[0,0,100,45],"weight":1,"asset":"hudButton","props":{"label":"|< PREV","command":"previous","id":"previous","group":"transport","order":0,"tone":"secondaryText"}},
        {"type":"component","bounds":[0,0,100,45],"weight":1,"asset":"hudButton","props":{"label":"PLAY / PAUSE","command":"playPause","id":"play","group":"transport","order":1,"tone":"accent"}},
        {"type":"component","bounds":[0,0,100,45],"weight":1,"asset":"hudButton","props":{"label":"NEXT >|","command":"next","id":"next","group":"transport","order":2,"tone":"secondaryText"}}

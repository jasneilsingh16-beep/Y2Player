  },
  "styles": {
    "title": {"size":20,"bold":true,"color":"primaryText","overflow":"marquee"},
    "label": {"size":12,"bold":true,"color":"accent"},
    "meta": {"size":10,"color":"secondaryText","overflow":"clip"},
    "micro": {"size":9,"color":"mutedText","overflow":"clip"},
    "display": {"size":34,"bold":true,"color":"accent","overflow":"clip"}
  },
  "components": {
    "header": [
      {"type":"rect","bounds":[0,0,480,42],"color":"surface","gradient":{"endColor":"surfaceRaised","direction":"horizontal"}},
      {"type":"path","bounds":[10,10,18,18],"points":[[0,0],[1,0.5],[0,1],[0.28,0.5]],"closed":true,"color":"accent","action":"back"},
      {"type":"text","bounds":[36,2,310,36],"text":"{screen.title}","style":"title","color":"accent","action":"back"},
      {"type":"text","bounds":[355,3,113,18],"text":"PWR {battery}","style":"meta","align":"right"},
      {"type":"text","bounds":[355,20,113,16],"text":"{clock}","style":"micro","align":"right"},
      {"type":"rect","bounds":[12,40,456,2],"color":"accent","gradient":{"endColor":"accentHot","direction":"horizontal"}}

        {"type":"component","bounds":[0,0,100,42],"weight":1,"asset":"hudButton","props":{"label":"VOL +","command":"volumeUp","id":"louder","group":"system","order":1,"tone":"electric"}},
        {"type":"component","bounds":[0,0,100,42],"weight":1,"asset":"hudButton","props":{"label":"OPTIONS","command":"confirm","id":"options","group":"system","order":2,"tone":"accentHot"}}
      ]},
      {"type":"component","bounds":[0,0,480,360],"asset":"overlays"}
    ],
    "search": [

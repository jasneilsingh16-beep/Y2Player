      {"type":"rows","bounds":[12,50,456,268],"rowHeight":48,"gap":5,"scrolling":"center","children":[{"type":"component","bounds":[0,0,456,48],"asset":"row"}]},
      {"type":"text","bounds":[28,92,424,104],"text":"{empty.message}","size":16,"color":"secondaryText","lines":3,"verticalAlign":"top","when":"emptyRows"},
      {"type":"component","bounds":[0,0,480,360],"asset":"footer"},
      {"type":"component","bounds":[0,0,480,360],"asset":"overlays"}
